################################################################################
#
# Run Claude Code or OpenCode in an isolated Docker container.
# Usage: codebox [OPTIONS] [DIR] [-- ARGS...]
#
# Options:
#   -r, --rebuild        Rebuild the Docker image(s) (uses layer cache)
#   -R, --force-rebuild  Force rebuild the Docker image(s) ignoring cache
#   --from IMAGE         Use IMAGE as the base Docker image instead of the
#                        default debian:trixie-slim. The image must have curl,
#                        bash, and ca-certificates available.
#   --no-credentials     Do not mount credential/config directories; requires
#                        ANTHROPIC_API_KEY for auth
#   --mount HOST:CONTAINER
#                        Additional bind mount (can be repeated; also reads
#                        CODEBOX_MOUNTS from .env.codebox). As a shorthand,
#                        :PATH mounts PATH at the same path in the container
#                        (:/data is equivalent to /data:/data, and options may
#                        be appended as :/data:ro)
#   --no-gitconfig       Do not mount host ~/.gitconfig into the container
#   --no-dockerfile      Ignore the directory's Dockerfile.codebox and run the
#                        base image instead
#   --trust              Trust this directory's Dockerfile.codebox and
#                        .env.codebox without prompting (needed for
#                        non-interactive use)
#   --allow-home         Allow DIR or a --mount host path to be your home
#                        directory (or an ancestor of it) without prompting;
#                        this exposes everything under it
#   --opencode           Use OpenCode (opencode.ai) instead of Claude Code
#   --codex              Use OpenAI Codex (chatgpt.com/codex) instead of Claude
#   --init               Generate a Dockerfile.codebox template in DIR
#   -h, --help           Show this help
#
# --opencode and --codex are mutually exclusive.
#
# Codex sandbox: Codex normally sandboxes the commands it runs (bubblewrap /
#   Landlock), which needs an unprivileged user namespace and cannot work
#   inside codebox's hardened container. Since the container is already the
#   sandbox, codebox runs Codex with -s danger-full-access to disable that
#   inner sandbox (approval prompts stay on). Pass your own -s/--sandbox,
#   --full-auto, or --dangerously-bypass-approvals-and-sandbox to override.
#
# DIR defaults to the current working directory.
# ARGS are passed through to `claude`, `opencode`, or `codex`.
#
# Credential mounts (default):
#   Claude Code: ~/.claude and ~/.claude.json mounted read-write.
#   OpenCode:    ~/.config/opencode mounted read-write.
#   Codex:       ~/.codex mounted read-write.
#   With --no-credentials a dedicated sandbox config dir is mounted instead of
#   the host's real one (~/.claude-codebox / ~/.config/opencode-codebox /
#   ~/.codex-codebox), so no host login state or host-executed hooks are
#   exposed. Auth via ANTHROPIC_API_KEY (or OPENAI_API_KEY for Codex) in that
#   case.
#
# Git config: ~/.gitconfig is mounted read-only into the container so that git
#   operations (commit, etc.) use your host identity. Use --no-gitconfig to skip.
#
# Job control: Ctrl-Z suspends the session and `fg` resumes it, like any other
#   job-control program. (Under the hood Ctrl-Z detaches from the container and
#   `fg` re-attaches; the container keeps running while suspended.)
#
# Environment: If the target directory contains a .env.codebox file, each
#   KEY=VALUE line is forwarded as an environment variable to the container.
#   Sensitive keys (ANTHROPIC_API_KEY, ANTHROPIC_BASE_URL, ANTHROPIC_AUTH_TOKEN,
#   CLAUDE_CONFIG_DIR) are refused since .env.codebox may come from an untrusted
#   target directory; forwarded keys are printed before the container starts.
#   CODEBOX_MOUNTS is treated as a space-separated list of HOST:CONTAINER mount
#   specifications and is forwarded as extra bind mounts. The :PATH identity
#   shorthand accepted by --mount works here too. Because a mount can expose
#   any host path, codebox prompts before using a .env.codebox it has not
#   seen before, the same way it does for Dockerfile.codebox (see below).
#
# If DIR contains a Dockerfile.codebox, it is built on top of the base image
# to add project-specific dependencies. It can start with:
#   FROM codebox          (Claude Code, the default)
#   FROM codebox-opencode (with --opencode)
#   FROM codebox-codex    (with --codex)
#   FROM ubuntu:24.04     (any image — codebox installs the AI tool on top and
#                          rewrites the FROM line to the resulting codebox image)
#   (no FROM line)      (the codebox base image is prepended for you)
# Using a third-party FROM in Dockerfile.codebox is equivalent to passing
# --from with that image. The --from flag takes priority if both are given.
# If Dockerfile.codebox declares ARG USER_ID or ARG GROUP_ID, codebox passes
# the host uid/gid as build args, so build-time installs can be chowned to the
# user the container runs as:
#   ARG USER_ID
#   ARG GROUP_ID
#   RUN chown -R $USER_ID:$GROUP_ID /opt/android-sdk
# Building it runs arbitrary code and the resulting image controls the
# container, so codebox prompts for confirmation before building a
# Dockerfile.codebox from a directory you have not already trusted. Trust is
# remembered per (directory, file SHA); editing the file re-prompts. Use
# --trust to skip the prompt (e.g. in scripts).
################################################################################

set -euo pipefail

IMAGE_NAME="codebox"
REBUILD=false
NO_CACHE=false
NO_CREDS=false
NO_GITCONFIG=false
NO_DOCKERFILE=false
USE_OPENCODE=false
USE_CODEX=false
TRUST=false
ALLOW_HOME=false
BASE_IMAGE="debian:trixie-slim"
FROM_EXPLICIT=false
ACTION="up"
EXTRA_MOUNTS=()

usage() {
    sed -n '/^# Run /,/^####/{ /^####/d; p }' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}

# Parse options
AFTER_DASHDASH=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--rebuild)        REBUILD=true; shift ;;
        -R|--force-rebuild)  REBUILD=true; NO_CACHE=true; shift ;;
        --from)              [[ $# -gt 1 ]] || { echo "error: --from requires an argument" >&2; exit 1; }
                             BASE_IMAGE="$2"; FROM_EXPLICIT=true; shift 2 ;;
        --no-credentials)    NO_CREDS=true; shift ;;
        --no-gitconfig)      NO_GITCONFIG=true; shift ;;
        --no-dockerfile)     NO_DOCKERFILE=true; shift ;;
        --trust)             TRUST=true; shift ;;
        --allow-home)        ALLOW_HOME=true; shift ;;
        --mount)             [[ $# -gt 1 ]] || { echo "error: --mount requires HOST:CONTAINER argument" >&2; exit 1; }
                             EXTRA_MOUNTS+=("$2"); shift 2 ;;
        --opencode)          USE_OPENCODE=true; shift ;;
        --codex)             USE_CODEX=true; shift ;;
        --init)              ACTION="init"; shift ;;
        -h|--help)           usage ;;
        --)           shift; AFTER_DASHDASH=true; break ;;
        -*)           echo "Unknown option: $1" >&2; exit 1 ;;
        *)            break ;;
    esac
done

# Only consume a DIR argument if -- was not used (otherwise the first
# claude arg would be mistaken for the directory).
if ! $AFTER_DASHDASH; then
    TARGET_DIR="${1:-$PWD}"
    shift 2>/dev/null || true
fi
TARGET_DIR="$(realpath "${TARGET_DIR:-$PWD}")"

# The target directory is mounted read-write, so making it your home directory
# (or an ancestor of it) hands the agent ~/.ssh, ~/.gnupg, ~/.aws, browser
# profiles and every other secret in there -- the opposite of what codebox is
# for. This is easy to do by accident: a bare `codebox` in the wrong shell does
# it. Confirm before proceeding.
HOME_REAL="$(realpath "$HOME" 2>/dev/null || echo "$HOME")"
guard_home() {
    local dir="${1%/}"
    $ALLOW_HOME && return 0
    [[ "$HOME_REAL" == "$dir" || "$HOME_REAL" == "$dir"/* ]] || return 0
    if [[ "$HOME_REAL" == "$dir" ]]; then
        echo "warning: $1 is your home directory." >&2
    else
        echo "warning: $1 contains your home directory ($HOME_REAL)." >&2
    fi
    echo "  It is mounted into the container, so the agent gets your ssh keys, cloud" >&2
    echo "  credentials and everything else under it. Prefer a project directory." >&2
    if [[ ! -t 0 ]]; then
        echo "error: refusing to mount your home directory without a tty." >&2
        echo "       Re-run with --allow-home if this is really what you want." >&2
        exit 1
    fi
    read -r -p "Mount it anyway? [y/N] " ans
    if [[ "$ans" != [yY] && "$ans" != [yY][eE][sS] ]]; then
        echo "Aborted." >&2
        exit 1
    fi
}
guard_home "$TARGET_DIR"

if $USE_OPENCODE && $USE_CODEX; then
    echo "error: --opencode and --codex are mutually exclusive" >&2
    exit 1
fi

if $USE_OPENCODE; then
    IMAGE_NAME="codebox-opencode"
elif $USE_CODEX; then
    IMAGE_NAME="codebox-codex"
fi

# If a non-default base image is requested, derive a unique image name so the
# custom-base build doesn't overwrite (or be confused with) the default one.
DEFAULT_BASE_IMAGE="debian:trixie-slim"
_base_image_tag_suffix() {
    if [[ "$BASE_IMAGE" != "$DEFAULT_BASE_IMAGE" ]]; then
        local hash
        hash="$(printf '%s' "$BASE_IMAGE" | sha256sum | cut -c1-12)"
        echo "--base-${hash}"
    fi
}
BASE_TAG_SUFFIX="$(_base_image_tag_suffix)"
unset -f _base_image_tag_suffix

if [[ ! -d "$TARGET_DIR" ]]; then
    echo "error: directory not found: $TARGET_DIR" >&2
    exit 1
fi

if [[ "$ACTION" == "init" ]]; then
    DOCKERFILE="$TARGET_DIR/Dockerfile.codebox"
    if [[ -f "$DOCKERFILE" ]]; then
        echo "error: $DOCKERFILE already exists" >&2
        exit 1
    fi
    if $USE_OPENCODE; then
        FROM_LINE="FROM codebox-opencode"
    elif $USE_CODEX; then
        FROM_LINE="FROM codebox-codex"
    else
        FROM_LINE="FROM codebox"
    fi
    cat > "$DOCKERFILE" <<DOCKERFILE
# Dockerfile.codebox — project dependencies for codebox
# ======================================================
# Your coding agent (Claude/OpenCode) can edit or recreate this file to
# pre-install system packages, language runtimes, and project deps.
#
# The FROM line below uses the codebox base image. You can replace it with
# any Docker image (e.g. FROM ubuntu:24.04) and codebox will install the AI
# tool on top automatically.
#
# Container context:
#   HOME = /home/sandbox
#   USER = your host uid:gid (e.g. $(id -u):$(id -g))
#   Working directory = your project directory (mounted read-write)
#   Credentials ~/.claude or ~/.config/opencode = mounted from host
#   Git config = mounted from host (~/.gitconfig, read-only)
#
# Declare ARG USER_ID or ARG GROUP_ID below and codebox passes the host uid/gid
# as build args, so files installed during the build can be chowned to the user
# the container runs as:
#   ARG USER_ID
#   ARG GROUP_ID
#   RUN chown -R \$USER_ID:\$GROUP_ID /opt/android-sdk

${FROM_LINE}

# Install system packages
# RUN apt-get update && apt-get install -y --no-install-recommends \\
#     socat psmisc procps iproute2 \\
#     && rm -rf /var/lib/apt/lists/*

# Install language runtimes (examples):
# RUN curl -fsSL https://astral.sh/uv/install.sh | sh
# RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && apt-get install -y nodejs

# Install project dependencies (examples):
# RUN uv sync
# RUN npm install
DOCKERFILE
    echo "Wrote $DOCKERFILE" >&2
    exit 0
fi

# Dockerfile.codebox and .env.codebox live in the (potentially untrusted)
# target directory, e.g. a cloned repo. A Dockerfile.codebox is arbitrary code
# run at build time (and controls the container's ENTRYPOINT, so it can read
# the mounted credentials); its FROM line alone pulls and runs a third-party
# image. A .env.codebox can bind-mount any host path via CODEBOX_MOUNTS. So
# require explicit trust before using either file. Trust is remembered per
# (directory, file SHA) so an unchanged file is not re-prompted; editing it
# re-prompts.
TRUST_STORE="${XDG_CONFIG_HOME:-$HOME/.config}/codebox/trusted"
require_trust() {
    local file="$1" desc="$2" key
    key="$(sha256sum "$file" | cut -d' ' -f1)  ${TARGET_DIR}"
    if ! $TRUST && ! grep -qxF "$key" "$TRUST_STORE" 2>/dev/null; then
        echo "warning: $TARGET_DIR contains a $(basename "$file")." >&2
        echo "$desc" >&2
        echo "  Only trust directories you control." >&2
        if [[ ! -t 0 ]]; then
            echo "error: refusing to use untrusted $(basename "$file") without a tty." >&2
            echo "       Re-run with --trust if you trust this directory." >&2
            exit 1
        fi
        read -r -p "Use it? [y/N] " ans
        if [[ "$ans" != [yY] && "$ans" != [yY][eE][sS] ]]; then
            echo "Aborted." >&2
            exit 1
        fi
    fi
    mkdir -p "$(dirname "$TRUST_STORE")"
    grep -qxF "$key" "$TRUST_STORE" 2>/dev/null || echo "$key" >> "$TRUST_STORE"
}

if ! $NO_DOCKERFILE && [[ -f "$TARGET_DIR/Dockerfile.codebox" ]]; then
    require_trust "$TARGET_DIR/Dockerfile.codebox" \
        "  It will be built and run on your machine; it can execute arbitrary
  code and read mounted credentials."
fi
if [[ -f "$TARGET_DIR/.env.codebox" ]]; then
    require_trust "$TARGET_DIR/.env.codebox" \
        "  It sets environment variables for the agent and can add bind mounts
  (CODEBOX_MOUNTS) that expose any host path to the container."
fi

# Build cache flag (empty unless cache-busting was requested). Using an array
# avoids the ${NO_CACHE:+...} trap where the literal string "false" is non-empty
# and would expand to --no-cache.
CACHE_ARG=()
$NO_CACHE && CACHE_ARG=(--no-cache)

# Build base image if missing or rebuild requested
BASE_IMAGE_NAME="${IMAGE_NAME}${BASE_TAG_SUFFIX}"
if ! $USE_OPENCODE && ! $USE_CODEX && { $REBUILD || ! docker image inspect "$BASE_IMAGE_NAME" &>/dev/null; }; then
    echo "Building $BASE_IMAGE_NAME..." >&2
    docker build "${CACHE_ARG[@]}" \
        --build-arg "BASE_IMAGE=$BASE_IMAGE" \
        -t "$BASE_IMAGE_NAME" - <<'DOCKERFILE'
ARG BASE_IMAGE=debian:trixie-slim
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/sandbox \
    && chmod 777 /home/sandbox

ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.local/bin:$PATH"

RUN curl -fsSL https://claude.ai/install.sh | bash

ENTRYPOINT ["claude"]
DOCKERFILE
fi

if $USE_OPENCODE && { $REBUILD || ! docker image inspect "$BASE_IMAGE_NAME" &>/dev/null; }; then
    echo "Building $BASE_IMAGE_NAME..." >&2
    docker build "${CACHE_ARG[@]}" \
        --build-arg "BASE_IMAGE=$BASE_IMAGE" \
        -t "$BASE_IMAGE_NAME" - <<'DOCKERFILE'
ARG BASE_IMAGE=debian:trixie-slim
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/sandbox \
    && chmod 777 /home/sandbox

ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.opencode/bin:/home/sandbox/.local/bin:$PATH"

RUN curl -fsSL https://opencode.ai/install | bash

ENTRYPOINT ["opencode"]
DOCKERFILE
fi

if $USE_CODEX && { $REBUILD || ! docker image inspect "$BASE_IMAGE_NAME" &>/dev/null; }; then
    echo "Building $BASE_IMAGE_NAME..." >&2
    docker build "${CACHE_ARG[@]}" \
        --build-arg "BASE_IMAGE=$BASE_IMAGE" \
        -t "$BASE_IMAGE_NAME" - <<'DOCKERFILE'
ARG BASE_IMAGE=debian:trixie-slim
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/sandbox \
    && chmod 777 /home/sandbox

ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.local/bin:$PATH"

RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh

ENTRYPOINT ["codex"]
DOCKERFILE
fi

# Check for a project-specific Dockerfile (opt-out via --no-dockerfile)
PROJECT_DOCKERFILE="$TARGET_DIR/Dockerfile.codebox"
RUN_IMAGE="$BASE_IMAGE_NAME"

# Extract FROM from Dockerfile.codebox: if it names a third-party image (not the
# codebox base), use it as the base for the codebox build and rewrite the FROM
# line to point at the resulting codebox base image before building the project
# image. The --from flag takes priority over any FROM in Dockerfile.codebox.
if ! $NO_DOCKERFILE && [[ -f "$PROJECT_DOCKERFILE" ]]; then
    # FROM is case-insensitive and may carry flags such as --platform=..., so
    # take the first field after FROM that is not a flag.
    _df_from="$(awk 'tolower($1) == "from" { for (i = 2; i <= NF; i++) if ($i !~ /^--/) { print $i; exit } }' \
        "$PROJECT_DOCKERFILE")"
    if ! $FROM_EXPLICIT && [[ -n "$_df_from" ]] \
            && [[ "$_df_from" != "codebox" && "$_df_from" != "codebox-opencode" && "$_df_from" != "codebox-codex" ]]; then
        BASE_IMAGE="$_df_from"
        BASE_TAG_SUFFIX="$(printf '%s' "$BASE_IMAGE" | sha256sum | cut -c1-12)"
        BASE_TAG_SUFFIX="--base-${BASE_TAG_SUFFIX}"
        BASE_IMAGE_NAME="${IMAGE_NAME}${BASE_TAG_SUFFIX}"
        RUN_IMAGE="$BASE_IMAGE_NAME"
        # Build (or rebuild) the codebox base on top of the extracted base image.
        if $REBUILD || ! docker image inspect "$BASE_IMAGE_NAME" &>/dev/null; then
            echo "Building $BASE_IMAGE_NAME from $BASE_IMAGE (extracted from Dockerfile.codebox)..." >&2
            if $USE_OPENCODE; then
                docker build "${CACHE_ARG[@]}" \
                    --build-arg "BASE_IMAGE=$BASE_IMAGE" \
                    -t "$BASE_IMAGE_NAME" - <<'DOCKERFILE'
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/sandbox \
    && chmod 777 /home/sandbox

ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.opencode/bin:/home/sandbox/.local/bin:$PATH"

RUN curl -fsSL https://opencode.ai/install | bash

ENTRYPOINT ["opencode"]
DOCKERFILE
            elif $USE_CODEX; then
                docker build "${CACHE_ARG[@]}" \
                    --build-arg "BASE_IMAGE=$BASE_IMAGE" \
                    -t "$BASE_IMAGE_NAME" - <<'DOCKERFILE'
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/sandbox \
    && chmod 777 /home/sandbox

ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.local/bin:$PATH"

RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh

ENTRYPOINT ["codex"]
DOCKERFILE
            else
                docker build "${CACHE_ARG[@]}" \
                    --build-arg "BASE_IMAGE=$BASE_IMAGE" \
                    -t "$BASE_IMAGE_NAME" - <<'DOCKERFILE'
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/sandbox \
    && chmod 777 /home/sandbox

ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.local/bin:$PATH"

RUN curl -fsSL https://claude.ai/install.sh | bash

ENTRYPOINT ["claude"]
DOCKERFILE
            fi
        fi
    fi
fi

if ! $NO_DOCKERFILE && [[ -f "$PROJECT_DOCKERFILE" ]]; then
    DIR_HASH="$(echo "$TARGET_DIR" | sha256sum | cut -c1-12)"
    # The tag includes the base image name, so switching --from (or the FROM
    # line) between runs does not reuse a project image built on another base.
    PROJECT_IMAGE="${BASE_IMAGE_NAME}--${DIR_HASH}"
    DOCKERFILE_SHA="$(sha256sum "$PROJECT_DOCKERFILE" | cut -d' ' -f1)"
    # The project image is also rebuilt when the base image it was built on has
    # been rebuilt since, e.g. to pick up a newer version of the agent.
    BASE_ID="$(docker image inspect --format '{{.Id}}' "$BASE_IMAGE_NAME" 2>/dev/null || true)"

    EXISTING_SHA="$(docker image inspect "$PROJECT_IMAGE" \
        --format '{{index .Config.Labels "claude-sandbox.dockerfile.sha256"}}' 2>/dev/null || true)"
    EXISTING_BASE_ID="$(docker image inspect "$PROJECT_IMAGE" \
        --format '{{index .Config.Labels "codebox.base.id"}}' 2>/dev/null || true)"
    if $REBUILD || [[ "$EXISTING_SHA" != "$DOCKERFILE_SHA" || "$EXISTING_BASE_ID" != "$BASE_ID" ]]; then
        echo "Building project image for $TARGET_DIR..." >&2

        # Compose the Dockerfile that is actually handed to docker build:
        #
        #   - Dockerfile.codebox has no FROM line (what --init writes, and what
        #     the template documents): prepend one naming the codebox base image
        #     that was just built, since docker needs a build stage.
        #   - It has a FROM line and a non-default base image is in use (--from,
        #     or a third-party FROM that was built into the codebox base above):
        #     rewrite the first FROM line to name the actual codebox base image
        #     so the project layers compose correctly.
        #     Only the image name is replaced, so flags such as --platform and
        #     an "AS stage" suffix are kept.
        EFFECTIVE_DOCKERFILE="$PROJECT_DOCKERFILE"
        TEMP_DOCKERFILE=""
        # Remove the temporary Dockerfile even when the build fails.
        trap '[[ -z "$TEMP_DOCKERFILE" ]] || rm -f "$TEMP_DOCKERFILE"' EXIT
        if ! grep -qiE '^[[:space:]]*FROM[[:space:]]' "$PROJECT_DOCKERFILE"; then
            TEMP_DOCKERFILE="$(mktemp --suffix=.dockerfile)"
            { printf 'FROM %s\n' "$BASE_IMAGE_NAME"; cat "$PROJECT_DOCKERFILE"; } \
                > "$TEMP_DOCKERFILE"
            EFFECTIVE_DOCKERFILE="$TEMP_DOCKERFILE"
        elif [[ "$BASE_IMAGE_NAME" != "$IMAGE_NAME" ]]; then
            TEMP_DOCKERFILE="$(mktemp --suffix=.dockerfile)"
            awk -v img="$BASE_IMAGE_NAME" '
                done || tolower($1) != "from" { print; next }
                { for (i = 2; i <= NF; i++) if ($i !~ /^--/) { $i = img; break }
                  print; done = 1 }' \
                "$PROJECT_DOCKERFILE" > "$TEMP_DOCKERFILE"
            EFFECTIVE_DOCKERFILE="$TEMP_DOCKERFILE"
        fi

        # The container runs as the host uid:gid, so a Dockerfile.codebox that
        # installs into a root-owned directory needs those ids at build time to
        # chown what it installed. Pass them only when the Dockerfile declares
        # the matching ARG, because docker warns about build args that the
        # Dockerfile never consumes.
        PROJECT_BUILD_ARGS=()
        for _arg in USER_ID GROUP_ID; do
            if grep -qiE "^[[:space:]]*ARG[[:space:]]+${_arg}([[:space:]]|=|\$)" \
                    "$EFFECTIVE_DOCKERFILE"; then
                case "$_arg" in
                    USER_ID)  PROJECT_BUILD_ARGS+=(--build-arg "USER_ID=$(id -u)") ;;
                    GROUP_ID) PROJECT_BUILD_ARGS+=(--build-arg "GROUP_ID=$(id -g)") ;;
                esac
            fi
        done

        docker build \
            "${CACHE_ARG[@]}" \
            "${PROJECT_BUILD_ARGS[@]}" \
            --label "claude-sandbox.dockerfile.sha256=${DOCKERFILE_SHA}" \
            --label "codebox.base.id=${BASE_ID}" \
            -t "$PROJECT_IMAGE" \
            -f "$EFFECTIVE_DOCKERFILE" \
            "$TARGET_DIR"
    fi
    RUN_IMAGE="$PROJECT_IMAGE"
fi

# Collect env vars to forward
ENV_ARGS=()
if $USE_CODEX; then
    ENV_VARS=(OPENAI_API_KEY OPENAI_BASE_URL)
else
    ENV_VARS=(ANTHROPIC_API_KEY ANTHROPIC_BASE_URL)
    if ! $USE_OPENCODE; then
        ENV_VARS+=(CLAUDE_CONFIG_DIR)
    fi
fi
for var in "${ENV_VARS[@]}"; do
    if [[ -n "${!var:-}" ]]; then
        ENV_ARGS+=(-e "$var=${!var}")
    fi
done

# Load .env.codebox from the target directory if present.
#
# .env.codebox lives inside the (potentially untrusted) target directory, so a
# cloned repo could ship one. Refuse keys that would redirect API traffic or
# relocate the config dir — e.g. ANTHROPIC_BASE_URL pointing at an attacker host
# would exfiltrate the API key / OAuth token in request headers. Forwarded keys
# are printed so they are visible before the container starts.
ENV_BLOCKLIST=(ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN CLAUDE_CONFIG_DIR OPENAI_API_KEY OPENAI_BASE_URL CODEX_HOME)
ENV_FILE="$TARGET_DIR/.env.codebox"
if [[ -f "$ENV_FILE" ]]; then
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        [[ -z "$key" || "$key" =~ ^# ]] && continue
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        blocked=false
        for b in "${ENV_BLOCKLIST[@]}"; do
            [[ "$key" == "$b" ]] && { blocked=true; break; }
        done
        if $blocked; then
            echo "warning: ignoring '$key' from .env.codebox (blocked sensitive key)" >&2
            continue
        fi
        echo "forwarding env from .env.codebox: $key" >&2
        ENV_ARGS+=(-e "${key}=${value}")
    done < "$ENV_FILE"

    # Extra mounts from CODEBOX_MOUNTS in .env.codebox
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        [[ "$key" != "CODEBOX_MOUNTS" ]] && continue
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        value="${value#\"}"; value="${value%\"}"
        value="${value#\'}"; value="${value%\'}"
        if [[ -n "$value" ]]; then
            while IFS=' ' read -ra mounts; do
                for m in "${mounts[@]}"; do
                    [[ -n "$m" ]] && EXTRA_MOUNTS+=("$m")
                done
            done <<< "$value"
        fi
        break
    done < "$ENV_FILE"
fi

# Credential/config mounts.
#
# With --no-credentials we mount a *dedicated* sandbox config dir rather than the
# host's real one. The host config dir is more than credentials: on Linux the
# OAuth refresh token lives in ~/.claude/.credentials.json, and ~/.claude both
# stores settings.json (which can define hooks that run on the host) and is
# mounted read-write. Pointing the container at a separate dir keeps cross-run
# persistence for the sandbox without exposing host login state or letting the
# sandbox write host-executed hooks. Auth is then expected via ANTHROPIC_API_KEY.
if $USE_CODEX; then
    if $NO_CREDS; then
        CODEX_CONFIG_HOST_DIR="${HOME}/.codex-codebox"
    else
        CODEX_CONFIG_HOST_DIR="${HOME}/.codex"
    fi
    mkdir -p "$CODEX_CONFIG_HOST_DIR"
    # Codex installs its own binary under /home/sandbox/.codex (the codex on
    # PATH symlinks into .codex/packages), so we cannot mount the host's
    # ~/.codex there without shadowing the binary. Instead mount it at a
    # separate path and point CODEX_HOME at it, which relocates just the
    # config/auth (auth.json, config.toml, history) and leaves the binary intact.
    CRED_MOUNTS=(-v "$CODEX_CONFIG_HOST_DIR:/home/sandbox/.codex-home")
    ENV_ARGS+=(-e "CODEX_HOME=/home/sandbox/.codex-home")
elif $USE_OPENCODE; then
    if $NO_CREDS; then
        OPENCODE_CONFIG_HOST_DIR="${HOME}/.config/opencode-codebox"
    else
        OPENCODE_CONFIG_HOST_DIR="${HOME}/.config/opencode"
    fi
    mkdir -p "$OPENCODE_CONFIG_HOST_DIR"
    CRED_MOUNTS=(-v "$OPENCODE_CONFIG_HOST_DIR:/home/sandbox/.config/opencode")
else
    if $NO_CREDS; then
        CLAUDE_HOST_DIR="${HOME}/.claude-codebox"
    else
        CLAUDE_HOST_DIR="${HOME}/.claude"
    fi
    mkdir -p "$CLAUDE_HOST_DIR"
    CRED_MOUNTS=(-v "$CLAUDE_HOST_DIR:/home/sandbox/.claude")
    if ! $NO_CREDS && [[ -f "${HOME}/.claude.json" ]]; then
        CRED_MOUNTS+=(-v "${HOME}/.claude.json:/home/sandbox/.claude.json")
    fi
fi

# Mount host ~/.gitconfig read-only inside the container (opt-out via --no-gitconfig)
GITCONFIG_MOUNTS=()
if ! $NO_GITCONFIG && [[ -f "${HOME}/.gitconfig" ]]; then
    GITCONFIG_MOUNTS=(-v "${HOME}/.gitconfig:/home/sandbox/.gitconfig:ro")
fi

# Unique name so a Ctrl-Z detach can be reattached.
CONTAINER_NAME="codebox-$(id -u)-$$"

# Ctrl-Z / fg job control.
#
# Goal: Ctrl-Z suspends the session and `fg` resumes it, like a normal program.
# This can't be done by forwarding the signal: `docker run -it` holds the host
# terminal in raw mode (ISIG cleared), so Ctrl-Z reaches the container as raw
# byte 0x1a and never generates SIGTSTP on the host -- the host shell never sees
# a stopped job, so there is nothing for `fg` to resume. (And the forwarded byte
# just stops claude *inside* the container while docker keeps the terminal.)
#
# So we build it on top of `docker attach` instead. Map Ctrl-Z to Docker's
# --detach-keys sequence: on Ctrl-Z the docker run/attach process exits cleanly
# (restoring the terminal) while the container keeps running. We then stop *this
# script* with SIGTSTP, so it becomes a stopped job in the host shell; when the
# user runs `fg` the script continues and re-attaches to the still-running
# container. Repeat for as many Ctrl-Z / fg cycles as the user likes.
container_running() { docker container inspect "$CONTAINER_NAME" &>/dev/null; }

# A mount spec starting with ':' is shorthand for an identity mount: the host
# path is mounted at the same path inside the container, the way the target
# directory itself is. ":PATH" becomes "PATH:PATH" and any trailing docker
# options are kept, so ":/data:ro" becomes "/data:/data:ro". The path is
# resolved (like TARGET_DIR) so relative shorthands such as ":../sibling" work.
EXTRA_VOLUME_ARGS=()
for m in "${EXTRA_MOUNTS[@]}"; do
    if [[ "$m" == :* ]]; then
        spec="${m#:}"
        mpath="${spec%%:*}"
        mopts="${spec#"$mpath"}"
        [[ -n "$mpath" ]] || { echo "error: --mount '$m': ':' shorthand requires a path (:PATH[:OPTIONS])" >&2; exit 1; }
        mpath="$(realpath "$mpath" 2>/dev/null)" || { echo "error: --mount '$m': no such path: ${spec%%:*}" >&2; exit 1; }
        m="${mpath}:${mpath}${mopts}"
    fi
    # A spec with no ':' is a docker *anonymous volume* -- an empty directory
    # that silently discards its contents when the container exits. Nobody
    # wants that from --mount, and it reads like a bind mount, so reject it.
    if [[ "$m" != *:* ]]; then
        echo "error: --mount '$m': missing ':'" >&2
        echo "       Use HOST:CONTAINER, or ':$m' to mount it at the same path." >&2
        exit 1
    fi
    # A host part that is a path (not a named volume) gets the same home
    # directory check as the target directory.
    mhost="${m%%:*}"
    if [[ "$mhost" == /* || "$mhost" == .* ]]; then
        guard_home "$(realpath -m "$mhost")"
    fi
    EXTRA_VOLUME_ARGS+=(-v "$m")
done

# Codex sandboxes model-generated commands itself (bubblewrap/Landlock, which
# needs an unprivileged user namespace). That can't work inside codebox's
# container -- we run with --cap-drop ALL and --security-opt no-new-privileges,
# so bwrap fails with "No permissions to create a new namespace". codebox's
# container is already the sandbox, so disable Codex's redundant inner sandbox
# with -s danger-full-access. Approval prompts are left on (like Claude here),
# so the agent still asks before running commands. Skip if the user already
# passed a sandbox/autonomy flag so their choice wins.
if $USE_CODEX; then
    _has_sandbox_flag=false
    for a in "$@"; do
        case "$a" in
            -s|--sandbox|--full-auto|--dangerously-bypass-approvals-and-sandbox)
                _has_sandbox_flag=true; break ;;
        esac
    done
    if ! $_has_sandbox_flag; then
        echo "codex: disabling Codex's inner sandbox (-s danger-full-access); codebox's container is the sandbox" >&2
        set -- -s danger-full-access "$@"
    fi
fi

docker run --rm -it \
    --name "$CONTAINER_NAME" \
    --detach-keys "ctrl-z" \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --user "$(id -u):$(id -g)" \
    -v "$TARGET_DIR:$TARGET_DIR" \
    "${CRED_MOUNTS[@]}" \
    "${GITCONFIG_MOUNTS[@]}" \
    "${EXTRA_VOLUME_ARGS[@]}" \
    -w "$TARGET_DIR" \
    -e HOME=/home/sandbox \
    "${ENV_ARGS[@]}" \
    "$RUN_IMAGE" \
    "$@" || rc=$?

# As long as the container is still alive after the foreground process exited,
# the user detached with Ctrl-Z: suspend ourselves (the shell reports a stopped
# job) and reattach when `fg` continues us.
while container_running; do
    kill -TSTP $$
    container_running || break
    rc=0
    docker attach --detach-keys ctrl-z "$CONTAINER_NAME" || rc=$?
done

# docker run and docker attach both exit with the agent's exit status when the
# agent exits while attached, so pass that status on to our caller.
exit "${rc:-0}"
