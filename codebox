if ! $NO_DOCKERFILE && [[ -f "$PROJECT_DOCKERFILE" ]]; then
    DIR_HASH="$(echo "$TARGET_DIR" | sha256sum | cut -c1-12)"
    # The tag includes the base image name, so switching --from (or the FROM
    # line) between runs does not reuse a project image built on another base.
    PROJECT_IMAGE="${BASE_IMAGE_NAME}--${DIR_HASH}"
    DOCKERFILE_SHA="$(sha256sum "$PROJECT_DOCKERFILE" | cut -d' ' -f1)"
    # The project image is also rebuilt when the base image it was built on has
    # been rebuilt since, e.g. to pick up a newer version of the agent.
    BASE_ID="$(docker image inspect --format '{{.Id}}' "$BASE_IMAGE_NAME" 2>/dev/null || true)"

    EXISTING_SHA="$(docker image inspect "$PROJECT_IMAGE" \
        --format '{{index .Config.Labels "claude-sandbox.dockerfile.sha256"}}' 2>/dev/null || true)"
    EXISTING_BASE_ID="$(docker image inspect "$PROJECT_IMAGE" \
        --format '{{index .Config.Labels "codebox.base.id"}}' 2>/dev/null || true)"
    if $REBUILD || [[ "$EXISTING_SHA" != "$DOCKERFILE_SHA" || "$EXISTING_BASE_ID" != "$BASE_ID" ]]; then
        echo "Building project image for $TARGET_DIR..." >&2

        # Compose the Dockerfile that is actually handed to docker build:
        #
        #   - Dockerfile.codebox has no FROM line (what --init writes, and what
        #     the template documents): prepend one naming the codebox base image
        #     that was just built, since docker needs a build stage.
        #   - It has a FROM line and a non-default base image is in use (--from,
        #     or a third-party FROM that was built into the codebox base above):
        #     rewrite the first FROM line to name the actual codebox base image
        #     so the project layers compose correctly.
        #     Only the image name is replaced, so flags such as --platform and
        #     an "AS stage" suffix are kept.
        # The EXIT trap (cleanup) removes the temporary Dockerfile, even when
        # the build fails.
        EFFECTIVE_DOCKERFILE="$PROJECT_DOCKERFILE"
        if ! grep -qiE '^[[:space:]]*FROM[[:space:]]' "$PROJECT_DOCKERFILE"; then
            TEMP_DOCKERFILE="$(mktemp --suffix=.dockerfile)"
            { printf 'FROM %s\n' "$BASE_IMAGE_NAME"; cat "$PROJECT_DOCKERFILE"; } \
                > "$TEMP_DOCKERFILE"
            EFFECTIVE_DOCKERFILE="$TEMP_DOCKERFILE"
        elif [[ "$BASE_IMAGE_NAME" != "$IMAGE_NAME" ]]; then
            TEMP_DOCKERFILE="$(mktemp --suffix=.dockerfile)"
            awk -v img="$BASE_IMAGE_NAME" '
                done || tolower($1) != "from" { print; next }
                { for (i = 2; i <= NF; i++) if ($i !~ /^--/) { $i = img; break }
                  print; done = 1 }' \
                "$PROJECT_DOCKERFILE" > "$TEMP_DOCKERFILE"
            EFFECTIVE_DOCKERFILE="$TEMP_DOCKERFILE"
        fi

        # The container runs as the host uid:gid, so a Dockerfile.codebox that
        # installs into a root-owned directory needs those ids at build time to
        # chown what it installed. Pass them only when the Dockerfile declares
        # the matching ARG, because docker warns about build args that the
        # Dockerfile never consumes.
        PROJECT_BUILD_ARGS=()
        for _arg in USER_ID GROUP_ID; do
            if grep -qiE "^[[:space:]]*ARG[[:space:]]+${_arg}([[:space:]]|=|\$)" \
                    "$EFFECTIVE_DOCKERFILE"; then
                case "$_arg" in
                    USER_ID)  PROJECT_BUILD_ARGS+=(--build-arg "USER_ID=$(id -u)") ;;
                    GROUP_ID) PROJECT_BUILD_ARGS+=(--build-arg "GROUP_ID=$(id -g)") ;;
                esac
            fi
        done

        docker build \
            "${CACHE_ARG[@]}" \
            "${PROJECT_BUILD_ARGS[@]}" \
            --label "claude-sandbox.dockerfile.sha256=${DOCKERFILE_SHA}" \
            --label "codebox.base.id=${BASE_ID}" \
            -t "$PROJECT_IMAGE" \
            -f "$EFFECTIVE_DOCKERFILE" \
            "$TARGET_DIR"
    fi
    RUN_IMAGE="$PROJECT_IMAGE"
fi

# With --tailscale, add the tailscale CLI to the image the agent runs, so that
# the agent can reach tailnet peers (`tailscale nc`). The binary is static, so
# copying it from the sidecar's image works on any base image. The CLI looks
# for the daemon's socket at /var/run/tailscale/tailscaled.sock, where the
# sidecar's socket volume is mounted; /tmp/tailscaled.sock is linked there too
# for commands written for codebox-tailclaude, which shared the socket there.
# The layer is rebuilt when the image under it changes.
if $USE_TAILSCALE; then
    TS_RUN_IMAGE="${RUN_IMAGE}--tailscale"
    RUN_ID="$(docker image inspect --format '{{.Id}}' "$RUN_IMAGE")"
    EXISTING_RUN_ID="$(docker image inspect "$TS_RUN_IMAGE" \
        --format '{{index .Config.Labels "codebox.base.id"}}' 2>/dev/null || true)"
    if $REBUILD || [[ "$EXISTING_RUN_ID" != "$RUN_ID" ]]; then
        # COPY --from uses the local tailscale image, so fetch a newer one
        # when a rebuild is requested.
        if $REBUILD; then
            docker pull "$TS_IMAGE"
        fi
        echo "Building $TS_RUN_IMAGE..." >&2
        docker build "${CACHE_ARG[@]}" \
            --label "codebox.base.id=${RUN_ID}" \
            -t "$TS_RUN_IMAGE" - <<DOCKERFILE
FROM ${TS_IMAGE} AS tailscale
FROM ${RUN_IMAGE}
USER root
COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscale
RUN ln -sf /var/run/tailscale/tailscaled.sock /tmp/tailscaled.sock
DOCKERFILE
    fi
    RUN_IMAGE="$TS_RUN_IMAGE"
fi

# Collect env vars to forward
ENV_ARGS=()
if $USE_CODEX; then
    ENV_VARS=(OPENAI_API_KEY OPENAI_BASE_URL)
else
    ENV_VARS=(ANTHROPIC_API_KEY ANTHROPIC_BASE_URL)
    if ! $USE_OPENCODE; then
        ENV_VARS+=(CLAUDE_CONFIG_DIR)
    fi
fi
for var in "${ENV_VARS[@]}"; do
    if [[ -n "${!var:-}" ]]; then
        ENV_ARGS+=(-e "$var=${!var}")
    fi
done

# Load environment files: first the user-wide one, then the project's.
#
# .env.codebox lives inside the (potentially untrusted) target directory, so a
# cloned repo could ship one. Refuse keys that would redirect API traffic or
# relocate the config dir — e.g. ANTHROPIC_BASE_URL pointing at an attacker host
# would exfiltrate the API key / OAuth token in request headers. The user-wide
# file is the user's own, so the blocklist does not apply to it. Docker uses
# the last -e for a key, so the project's values override the user's, except
# for blocked keys, which only the user file can set. CODEBOX_MOUNTS from both
# files are combined. Forwarded keys are printed so they are visible before the
# container starts.
#
# The Tailscale keys configure the sidecar (--tailscale). They are taken out of
# the files here and never forwarded to the agent, because an auth key would
# let the agent add devices to your tailnet. The host environment provides the
# defaults.
TS_AUTH_KEY_VALUE="${TS_AUTH_KEY:-}"
TS_AUTH_KEY_SRC="your environment"
TS_EXTRA_ARGS_VALUE="${TS_EXTRA_ARGS:-}"
ENV_BLOCKLIST=(ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN CLAUDE_CONFIG_DIR OPENAI_API_KEY OPENAI_BASE_URL CODEX_HOME TS_EXTRA_ARGS)
load_env_file() {
    local env_file="$1" use_blocklist="$2" label="$3"
    local key value blocked b m mounts
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        [[ -z "$key" || "$key" =~ ^# ]] && continue
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        if $use_blocklist; then
            blocked=false
            for b in "${ENV_BLOCKLIST[@]}"; do
                [[ "$key" == "$b" ]] && { blocked=true; break; }
            done
            if $blocked; then
                echo "warning: ignoring '$key' from $label (blocked sensitive key)" >&2
                continue
            fi
        fi
        case "$key" in
            TS_AUTH_KEY|TS_EXTRA_ARGS)
                if $USE_TAILSCALE; then
                    echo "using '$key' from $label for the tailscale sidecar (not forwarded to the agent)" >&2
                    printf -v "${key}_VALUE" '%s' "$value"
                    [[ "$key" != TS_AUTH_KEY ]] || TS_AUTH_KEY_SRC="$label"
                fi
                continue ;;
        esac
        echo "forwarding env from $label: $key" >&2
        ENV_ARGS+=(-e "${key}=${value}")
    done < "$env_file"

    # Extra mounts from CODEBOX_MOUNTS
    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        key="${key#"${key%%[![:space:]]*}"}"
        key="${key%"${key##*[![:space:]]}"}"
        [[ "$key" != "CODEBOX_MOUNTS" ]] && continue
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        value="${value#\"}"; value="${value%\"}"
        value="${value#\'}"; value="${value%\'}"
        if [[ -n "$value" ]]; then
            while IFS=' ' read -ra mounts; do
                for m in "${mounts[@]}"; do
                    [[ -n "$m" ]] || continue
                    EXTRA_MOUNTS+=("$m")
                    EXTRA_MOUNT_SRCS+=("$label")
                done
            done <<< "$value"
        fi
        break
    done < "$env_file"
}
if [[ -f "$USER_ENV_FILE" ]]; then
    load_env_file "$USER_ENV_FILE" false "$USER_ENV_FILE"
fi
if [[ -f "$TARGET_DIR/.env.codebox" ]]; then
    load_env_file "$TARGET_DIR/.env.codebox" true ".env.codebox"
fi
for m in "${CLI_MOUNTS[@]}"; do
    EXTRA_MOUNTS+=("$m")
    EXTRA_MOUNT_SRCS+=("--mount")
done

# Credential/config mounts.
#
# With --no-credentials we mount a *dedicated* sandbox config dir rather than the
# host's real one. The host config dir is more than credentials: on Linux the
# OAuth refresh token lives in ~/.claude/.credentials.json, and ~/.claude both
# stores settings.json (which can define hooks that run on the host) and is
# mounted read-write. Pointing the container at a separate dir keeps cross-run
# persistence for the sandbox without exposing host login state or letting the
# sandbox write host-executed hooks. Auth is then expected via ANTHROPIC_API_KEY.
if $USE_CODEX; then
    if $NO_CREDS; then
        CODEX_CONFIG_HOST_DIR="${HOME}/.codex-codebox"
    else
        CODEX_CONFIG_HOST_DIR="${HOME}/.codex"
    fi
    mkdir -p "$CODEX_CONFIG_HOST_DIR"
    # Codex installs its own binary under /home/sandbox/.codex (the codex on
    # PATH symlinks into .codex/packages), so we cannot mount the host's
    # ~/.codex there without shadowing the binary. Instead mount it at a
    # separate path and point CODEX_HOME at it, which relocates just the
    # config/auth (auth.json, config.toml, history) and leaves the binary intact.
    CRED_MOUNTS=(-v "$CODEX_CONFIG_HOST_DIR:/home/sandbox/.codex-home")
    ENV_ARGS+=(-e "CODEX_HOME=/home/sandbox/.codex-home")
elif $USE_OPENCODE; then
    if $NO_CREDS; then
        OPENCODE_CONFIG_HOST_DIR="${HOME}/.config/opencode-codebox"
    else
        OPENCODE_CONFIG_HOST_DIR="${HOME}/.config/opencode"
    fi
    mkdir -p "$OPENCODE_CONFIG_HOST_DIR"
    CRED_MOUNTS=(-v "$OPENCODE_CONFIG_HOST_DIR:/home/sandbox/.config/opencode")
else
    if $NO_CREDS; then
        CLAUDE_HOST_DIR="${HOME}/.claude-codebox"
    else
        CLAUDE_HOST_DIR="${HOME}/.claude"
    fi
    mkdir -p "$CLAUDE_HOST_DIR"
    CRED_MOUNTS=(-v "$CLAUDE_HOST_DIR:/home/sandbox/.claude")
    if ! $NO_CREDS && [[ -f "${HOME}/.claude.json" ]]; then
        CRED_MOUNTS+=(-v "${HOME}/.claude.json:/home/sandbox/.claude.json")
    fi
fi

# Mount host ~/.gitconfig read-only inside the container (opt-out via --no-gitconfig)
GITCONFIG_MOUNTS=()
if ! $NO_GITCONFIG && [[ -f "${HOME}/.gitconfig" ]]; then
    GITCONFIG_MOUNTS=(-v "${HOME}/.gitconfig:/home/sandbox/.gitconfig:ro")
fi

# Unique name so a Ctrl-Z detach can be reattached.
CONTAINER_NAME="codebox-$(id -u)-$$"

# Ctrl-Z / fg job control.
#
# Goal: Ctrl-Z suspends the session and `fg` resumes it, like a normal program.
# The host shell can only resume a job it has seen stop, and Ctrl-Z never stops
# anything on the host: `docker attach` holds the host terminal in raw mode
# (ISIG cleared), so the key is forwarded into the container instead. So this
# script leaves the container running, stops *itself* with SIGTSTP (the shell
# then reports a stopped job), and re-attaches when `fg` continues it. Ctrl-Z
# reaches one of two places:
#
#   - Docker. --detach-keys ctrl-z makes `docker attach` exit while the
#     container keeps running.
#   - The agent. Claude Code switches the terminal into a keyboard mode that
#     sends Ctrl-Z as an escape sequence, which Docker's detach-key matcher
#     does not recognise, and since version 2.0.76 it handles Ctrl-Z by
#     stopping itself with SIGTSTP. That needs --init: as the container's
#     PID 1, Claude would have its stop signal ignored by the kernel and would
#     hang waiting to be resumed. While attached, a background watcher polls
#     `docker top` for a stopped process and ends the attach client when it
#     finds one.
#
# On `fg` the script re-attaches and sends SIGCONT to the container's init
# (docker-init), which forwards it to the agent, so a stopped agent resumes and
# redraws. SIGCONT is harmless to an agent that was not stopped.
#
# The container is started detached and only ever reached through
# `docker attach`, because ending a `docker run -it` client would close the
# container's stdin. It is not started with --rm, so that its output and exit
# status are still available if the agent exits before the first attach; the
# EXIT trap removes it instead.
container_running() {
    [[ "$(docker container inspect --format '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" == true ]]
}

container_has_stopped_process() {
    docker top "$CONTAINER_NAME" -o stat 2>/dev/null \
        | awk 'NR > 1 && /^T/ { found = 1 } END { exit !found }'
}

# Runs in the background while attached. When a process in the container has
# stopped itself, end the attach client so that the main loop can suspend this
# script.
watch_for_stop() {
    local client
    while sleep 0.3; do
        client="$(cat "$ATTACH_PIDFILE" 2>/dev/null || true)"
        [[ -n "$client" ]] || continue
        kill -0 "$client" 2>/dev/null || return 0
        if container_has_stopped_process; then
            kill -TERM "$client" 2>/dev/null || true
            return 0
        fi
    done
}

# Attach to the container until the agent exits, the user detaches, or the
# agent stops itself. With "resume", also send SIGCONT once the client has had
# time to connect, so that the agent's redraw is not lost.
attach_once() {
    local resume="$1" watcher
    : > "$ATTACH_PIDFILE"
    watch_for_stop &
    watcher=$!
    if $resume; then
        { sleep 0.5; docker kill --signal CONT "$CONTAINER_NAME" >/dev/null 2>&1 || true; } &
    fi
    # --sig-proxy=false: the watcher's SIGTERM must end the client, not be
    # forwarded to the agent. Docker's own errors go to a file, so that they
    # can be told apart from the agent's output (which is all on stdout, since
    # the container has a tty). The outer 2>/dev/null discards bash's
    # "Terminated" report when the watcher ends the client.
    { ( echo "$BASHPID" > "$ATTACH_PIDFILE"
        exec docker attach --detach-keys ctrl-z --sig-proxy=false "$CONTAINER_NAME" 2>"$ATTACH_ERRFILE" ); } 2>/dev/null || true
    kill "$watcher" 2>/dev/null || true
    wait "$watcher" 2>/dev/null || true
    # A client ended by the watcher leaves the terminal in raw mode.
    [[ -z "$STTY_SAVED" ]] || stty "$STTY_SAVED" 2>/dev/null || true
}

# A mount spec starting with ':' is shorthand for an identity mount: the host
# path is mounted at the same path inside the container, the way the target
# directory itself is. ":PATH" becomes "PATH:PATH" and any trailing docker
# options are kept, so ":/data:ro" becomes "/data:/data:ro". The path is
# resolved (like TARGET_DIR) so relative shorthands such as ":../sibling" work.
#
# Docker refuses to start a container when two mounts share a container path,
# so duplicates are resolved here. An extra mount at the same container path
# as one of codebox's own mounts (the target directory, the agent's config,
# .gitconfig) is ignored, since the agent depends on those. Between extra
# mounts the later one wins (user env file, then .env.codebox, then --mount),
# with a warning unless the two specs are identical.
mount_dest() {
    local dest="${1#*:}"
    dest="${dest%%:*}"
    while [[ "$dest" == */ && "$dest" != / ]]; do dest="${dest%/}"; done
    printf '%s' "$dest"
}
BUILTIN_DESTS=("$TARGET_DIR")
BUILTIN_DESCS=("the project directory")
for a in "${CRED_MOUNTS[@]}"; do
    [[ "$a" == -v ]] && continue
    BUILTIN_DESTS+=("$(mount_dest "$a")"); BUILTIN_DESCS+=("the agent's config")
done
for a in "${GITCONFIG_MOUNTS[@]}"; do
    [[ "$a" == -v ]] && continue
    BUILTIN_DESTS+=("$(mount_dest "$a")"); BUILTIN_DESCS+=("~/.gitconfig")
done
if $USE_TAILSCALE; then
    BUILTIN_DESTS+=(/var/run/tailscale); BUILTIN_DESCS+=("the tailscale socket")
fi
MOUNT_SPECS=(); MOUNT_DESTS=(); MOUNT_SRCS=()
for i in "${!EXTRA_MOUNTS[@]}"; do
    m="${EXTRA_MOUNTS[$i]}"
    src="${EXTRA_MOUNT_SRCS[$i]}"
    if [[ "$m" == :* ]]; then
        spec="${m#:}"
        mpath="${spec%%:*}"
        mopts="${spec#"$mpath"}"
        [[ -n "$mpath" ]] || { echo "error: $src '$m': ':' shorthand requires a path (:PATH[:OPTIONS])" >&2; exit 1; }
        mpath="$(realpath "$mpath" 2>/dev/null)" || { echo "error: $src '$m': no such path: ${spec%%:*}" >&2; exit 1; }
        m="${mpath}:${mpath}${mopts}"
    fi
    # A spec with no ':' is a docker *anonymous volume* -- an empty directory
    # that silently discards its contents when the container exits. Nobody
    # wants that from --mount, and it reads like a bind mount, so reject it.
    if [[ "$m" != *:* ]]; then
        echo "error: $src '$m': missing ':'" >&2
        echo "       Use HOST:CONTAINER, or ':$m' to mount it at the same path." >&2
        exit 1
    fi

    dest="$(mount_dest "$m")"
    builtin=""
    for j in "${!BUILTIN_DESTS[@]}"; do
        [[ "${BUILTIN_DESTS[$j]}" == "$dest" ]] && { builtin="${BUILTIN_DESCS[$j]}"; break; }
    done
    if [[ -n "$builtin" ]]; then
        echo "warning: ignoring mount '$m' from $src: codebox already mounts $builtin at $dest" >&2
        continue
    fi
    replaced=false
    for j in "${!MOUNT_DESTS[@]}"; do
        [[ "${MOUNT_DESTS[$j]}" == "$dest" ]] || continue
        if [[ "${MOUNT_SPECS[$j]}" != "$m" ]]; then
            echo "warning: mount '$m' from $src replaces '${MOUNT_SPECS[$j]}' from ${MOUNT_SRCS[$j]} at $dest" >&2
        fi
        MOUNT_SPECS[$j]="$m"; MOUNT_SRCS[$j]="$src"
        replaced=true
        break
    done
    if ! $replaced; then
        MOUNT_SPECS+=("$m"); MOUNT_DESTS+=("$dest"); MOUNT_SRCS+=("$src")
    fi
done
EXTRA_VOLUME_ARGS=()
for m in "${MOUNT_SPECS[@]}"; do
    # A host part that is a path (not a named volume) gets the same home
    # directory check as the target directory.
    mhost="${m%%:*}"
    if [[ "$mhost" == /* || "$mhost" == .* ]]; then
        guard_home "$(realpath -m "$mhost")"
    fi
    EXTRA_VOLUME_ARGS+=(-v "$m")
done

# Codex sandboxes model-generated commands itself (bubblewrap/Landlock, which
# needs an unprivileged user namespace). That can't work inside codebox's
# container -- we run with --cap-drop ALL and --security-opt no-new-privileges,
# so bwrap fails with "No permissions to create a new namespace". codebox's
# container is already the sandbox, so disable Codex's redundant inner sandbox
# with -s danger-full-access. Approval prompts are left on (like Claude here),
# so the agent still asks before running commands. Skip if the user already
# passed a sandbox/autonomy flag so their choice wins.
if $USE_CODEX; then
    _has_sandbox_flag=false
    for a in "$@"; do
        case "$a" in
            -s|--sandbox|--full-auto|--dangerously-bypass-approvals-and-sandbox)
                _has_sandbox_flag=true; break ;;
        esac
    done
    if ! $_has_sandbox_flag; then
        echo "codex: disabling Codex's inner sandbox (-s danger-full-access); codebox's container is the sandbox" >&2
        set -- -s danger-full-access "$@"
    fi
fi

ATTACH_PIDFILE="$(mktemp)"
ATTACH_ERRFILE="$(mktemp)"
STTY_SAVED="$(stty -g 2>/dev/null || true)"

# Start the Tailscale sidecar. The agent's container joins its network
# namespace, so the agent's ports are the node's ports. The sidecar runs in
# userspace networking mode (the image's default), which needs no tun device
# and no added capabilities. The auth key reaches docker through the
# environment rather than the command line, where other host users could read
# it.
NETWORK_ARGS=()
if $USE_TAILSCALE; then
    TS_STARTED=true
    docker volume create "$TS_SOCKET_VOLUME" >/dev/null
    TS_AUTHKEY="$TS_AUTH_KEY_VALUE" TS_EXTRA_ARGS="$TS_EXTRA_ARGS_VALUE" \
    docker run -d \
        --name "$TS_CONTAINER" \
        --hostname "$TS_HOSTNAME" \
        --security-opt no-new-privileges \
        -e TS_AUTHKEY \
        -e TS_EXTRA_ARGS \
        -e TS_STATE_DIR=/var/lib/tailscale \
        -e TS_SOCKET=/var/run/tailscale/tailscaled.sock \
        -e TS_USERSPACE=true \
        -v "$TS_STATE_VOLUME:/var/lib/tailscale" \
        -v "$TS_SOCKET_VOLUME:/var/run/tailscale" \
        "$TS_IMAGE" >/dev/null

    # The sidecar exits when it cannot log in, most often because the
    # control server rejected the auth key. Its log is long, so save it and
    # report only the error it ends with. The log is saved because the EXIT
    # trap removes the sidecar.
    ts_sidecar_failed() {
        local log_file reason
        log_file="${XDG_STATE_HOME:-$HOME/.local/state}/codebox/tailscale-${TS_SUFFIX}.log"
        mkdir -p "$(dirname "$log_file")"
        docker logs "$TS_CONTAINER" > "$log_file" 2>&1 || true
        reason="$(sed -n 's/^backend error: //p' "$log_file" | tail -1)"
        [[ -n "$reason" ]] \
            || reason="$(sed -n 's/^boot: [0-9/]* [0-9:]* //p' "$log_file" | tail -1)"
        echo "error: the tailscale sidecar could not join the tailnet${reason:+: $reason}" >&2
        if [[ "$reason" == *"invalid key"* || "$reason" == *expired* ]]; then
            echo "       The control server rejected TS_AUTH_KEY from $TS_AUTH_KEY_SRC." >&2
            if [[ "$TS_AUTH_KEY_VALUE" == [\"\']* ]]; then
                echo "       Its value starts with a quote, which codebox passes on as part of the" >&2
                echo "       key. Remove the quotes." >&2
            else
                echo "       The key may be revoked or expired, a one-off key that was already" >&2
                echo "       used, or not an auth key (those start with tskey-auth-). Make a new" >&2
                echo "       one at https://login.tailscale.com/admin/settings/keys" >&2
            fi
        fi
        echo "       The sidecar's full log is in $log_file" >&2
        exit 1
    }

    # Wait for the node to join the tailnet. Without an auth key, show the
    # login URL from the sidecar's log and give the user time to use it.
    if [[ -n "$TS_AUTH_KEY_VALUE" ]]; then ts_wait=30; else ts_wait=300; fi
    ts_ip=""
    ts_url=""
    for ((i = 0; i < ts_wait; i++)); do
        if [[ "$(docker container inspect --format '{{.State.Running}}' "$TS_CONTAINER" 2>/dev/null)" != true ]]; then
            ts_sidecar_failed
        fi
        ts_ip="$(docker exec "$TS_CONTAINER" tailscale ip -4 2>/dev/null || true)"
        [[ -z "$ts_ip" ]] || break
        if [[ -z "$TS_AUTH_KEY_VALUE" && -z "$ts_url" ]]; then
            ts_url="$(docker logs "$TS_CONTAINER" 2>&1 \
                | grep -o 'https://login\.tailscale\.com/[^[:space:]]*' | head -1 || true)"
            [[ -z "$ts_url" ]] || echo "To add $TS_HOSTNAME to your tailnet, log in at: $ts_url" >&2
        fi
        sleep 1
    done
    if [[ -n "$ts_ip" ]]; then
        echo "Tailnet: $TS_HOSTNAME ($ts_ip)" >&2
        # Serve settings are kept in the node's state, so clear the ones a
        # previous run made before applying this run's.
        docker exec "$TS_CONTAINER" tailscale serve reset >/dev/null 2>&1 || true
        if [[ -n "$SERVE_PORT" ]]; then
            if $SERVE_HTTPS; then serve_listen=(--https=443); else serve_listen=(--http=80); fi
            docker exec "$TS_CONTAINER" tailscale serve --bg "${serve_listen[@]}" \
                "http://localhost:${SERVE_PORT}" >&2 \
                || echo "warning: tailscale serve failed; port $SERVE_PORT is not served" >&2
        fi
    else
        echo "warning: $TS_HOSTNAME has not joined the tailnet after ${ts_wait}s; starting the agent anyway." >&2
        echo "         See: docker logs $TS_CONTAINER" >&2
        [[ -z "$SERVE_PORT" ]] || echo "warning: port $SERVE_PORT is not served" >&2
    fi
    NETWORK_ARGS=(--network "container:$TS_CONTAINER" -v "$TS_SOCKET_VOLUME:/var/run/tailscale")
fi

CONTAINER_STARTED=true
docker run -d -it --init \
    --name "$CONTAINER_NAME" \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --user "$(id -u):$(id -g)" \
    -v "$TARGET_DIR:$TARGET_DIR" \
    "${CRED_MOUNTS[@]}" \
    "${GITCONFIG_MOUNTS[@]}" \
    "${EXTRA_VOLUME_ARGS[@]}" \
    "${NETWORK_ARGS[@]}" \
    -w "$TARGET_DIR" \
    -e HOME=/home/sandbox \
    "${ENV_ARGS[@]}" \
    "$RUN_IMAGE" \
    "$@" >/dev/null

attach_once false

# The agent exited before the client could attach (e.g. `-- --version`), so
# its output was never shown: show it now.
if grep -q 'cannot attach to a stopped container' "$ATTACH_ERRFILE"; then
    docker logs "$CONTAINER_NAME"
elif [[ -s "$ATTACH_ERRFILE" ]]; then
    cat "$ATTACH_ERRFILE" >&2
fi

# As long as the container is still running after the attach client exited,
# the user pressed Ctrl-Z: suspend ourselves and reattach when `fg` continues
# us.
while container_running; do
    kill -TSTP $$
    container_running || break
    attach_once true
done

# Pass the agent's exit status on to our caller.
exit "$(docker container inspect --format '{{.State.ExitCode}}' "$CONTAINER_NAME" 2>/dev/null || echo 1)"
