################################################################################
#
# Usage: codebox-web [OPTIONS] [DIR]
#
# Run OpenCode web in an isolated Docker container, accessible via Tailscale.
# Your project directory is mounted read-write into the container.
#
# Options:
#   -r, --rebuild         Rebuild the base Docker image (uses layer cache)
#   -R, --force-rebuild   Rebuild the base image ignoring cache
#   -d, --detach          Run in background (default: foreground)
#   --port PORT           Port for opencode web (default: 3000)
#   --stop                Stop the server and remove containers
#   --logs                Follow logs of a running server
#   --status              Show Tailscale IP and container status
#   --no-credentials      Do not mount host opencode config; use
#                         ANTHROPIC_API_KEY instead
#   --init                Generate a Dockerfile.codebox template for this
#                         directory (explains mounts, working dir, etc.)
#   -p, --publish HOST:PORT
#                         Publish a port from the container to the host
#                         (e.g. 127.0.0.1:3000:3000)
#   --no-dockerfile       Ignore Dockerfile.codebox and use base image
#   --trust               Trust Dockerfile.codebox without prompting
#   -h, --help            Show this help
#
# DIR defaults to the current working directory.
#
# If DIR contains a Dockerfile.codebox, it is built on top of the base image
# to add project-specific dependencies. It should start with:
#   FROM codebox-opencode
#
# Environment variables:
#   TS_AUTH_KEY           Tailscale auth key (get one at
#                         https://login.tailscale.com/admin/settings/authkeys)
#   ANTHROPIC_API_KEY     Anthropic API key (required without --no-credentials
#                         if not already logged in via opencode config)
#
# Examples:
#   codebox-web                           # Run in current dir (foreground)
#   codebox-web -d ~/src/myproject        # Run in background
#   TS_AUTH_KEY=tskey-... codebox-web -d  # Run with Tailscale auth key
#   codebox-web --stop                    # Stop the server
#   codebox-web --logs                    # Follow logs
################################################################################

set -euo pipefail

NAME="$(basename "$0")"

usage() {
    sed -n '/^# Usage:/,/^####/{ /^####/d; p }' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}

REBUILD=false
NO_CACHE=false
DETACH=false
PORT=3000
ACTION="up"
NO_CREDS=false
NO_DOCKERFILE=false
TRUST=false
PUBLISH=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--rebuild)        REBUILD=true; shift ;;
        -R|--force-rebuild)  REBUILD=true; NO_CACHE=true; shift ;;
        -d|--detach)         DETACH=true; shift ;;
        --port)              PORT="$2"; shift 2 ;;
        --stop)              ACTION="stop"; shift ;;
        --logs)              ACTION="logs"; shift ;;
        --status)            ACTION="status"; shift ;;
        --no-credentials)    NO_CREDS=true; shift ;;
        --init)              ACTION="init"; shift ;;
        -p|--publish)        PUBLISH="$2"; shift 2 ;;
        --no-dockerfile)     NO_DOCKERFILE=true; shift ;;
        --trust)             TRUST=true; shift ;;
        -h|--help)           usage ;;
        --)                  shift; break ;;
        -*)                  echo "error: unknown option: $1" >&2; exit 1 ;;
        *)                   TARGET_DIR="$1"; shift ;;
    esac
done

TARGET_DIR="$(realpath "${TARGET_DIR:-$PWD}")"

if [[ ! -d "$TARGET_DIR" ]]; then
    echo "error: directory not found: $TARGET_DIR" >&2
    exit 1
fi

# Deterministic suffix per target directory (for compose project + volume names)
SUFFIX="$(echo "$TARGET_DIR" | sha256sum | cut -c1-8)"
PROJECT="codebox-web-${SUFFIX}"
COMPOSE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/codebox/compose-web"

command -v docker >/dev/null 2>&1 || { echo "error: docker not found" >&2; exit 1; }

CACHE_ARG=()
$NO_CACHE && CACHE_ARG=(--no-cache)
RUN_IMAGE="codebox-opencode"

ensure_base_image() {
    if ! $REBUILD && docker image inspect codebox-opencode &>/dev/null; then
        return 0
    fi
    echo "Building codebox-opencode base image..." >&2
    docker build "${CACHE_ARG[@]}" --network=host -t codebox-opencode - <<'DOCKERFILE'
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git ca-certificates xdg-utils \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/sandbox \
    && chmod 777 /home/sandbox
ENV HOME=/home/sandbox
ENV PATH="/home/sandbox/.opencode/bin:/home/sandbox/.local/bin:$PATH"
RUN curl -fsSL https://opencode.ai/install | bash
ENTRYPOINT ["opencode"]
DOCKERFILE
}

generate_compose() {
    mkdir -p "$COMPOSE_DIR"

    if $NO_CREDS; then
        CONFIG_VOLUME="opencode-config-codebox"
    else
        CONFIG_VOLUME="opencode-config"
    fi

    cat > "$COMPOSE_DIR/docker-compose.yml" <<EOF
services:
  tailscale:
    image: tailscale/tailscale:latest
    hostname: opencode-web-${SUFFIX}
    environment:
      TS_AUTH_KEY: \${TS_AUTH_KEY:-}
      TS_STATE_DIR: /var/lib/tailscale
      TS_EXTRA_ARGS: \${TS_EXTRA_ARGS:-}
$( [[ -z "$PUBLISH" ]] || echo "    ports:" )
$( [[ -z "$PUBLISH" ]] || echo "      - \"${PUBLISH}\"" )
    volumes:
      - ts-data-${SUFFIX}:/var/lib/tailscale
      - /dev/net/tun:/dev/net/tun
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    restart: unless-stopped

  opencode:
    image: ${RUN_IMAGE}
    network_mode: "service:tailscale"
    user: "$(id -u):$(id -g)"
    environment:
      HOME: /home/sandbox
      ANTHROPIC_API_KEY: \${ANTHROPIC_API_KEY:-}
      BROWSER: /bin/true
    volumes:
      - "${TARGET_DIR}:${TARGET_DIR}"
EOF

    if ! $NO_CREDS; then
        OPENCODE_CONFIG_HOST="${HOME}/.config/opencode"
        mkdir -p "$OPENCODE_CONFIG_HOST"
        echo "      - ${OPENCODE_CONFIG_HOST}:/home/sandbox/.config/opencode" >> "$COMPOSE_DIR/docker-compose.yml"
    fi

    cat >> "$COMPOSE_DIR/docker-compose.yml" <<EOF
    working_dir: "${TARGET_DIR}"
    command: ["web", "--hostname", "0.0.0.0", "--port", "${PORT}"]
    depends_on:
      - tailscale

volumes:
  ts-data-${SUFFIX}:
EOF
}

ensure_compose_plugin() {
    docker compose version &>/dev/null && return 0
    echo "error: 'docker compose' plugin not available" >&2
    echo "Install Docker Compose v2: https://docs.docker.com/compose/install/" >&2
    exit 1
}

case "$ACTION" in
init)
    DOCKERFILE="$TARGET_DIR/Dockerfile.codebox"
    if [[ -f "$DOCKERFILE" ]]; then
        echo "error: $DOCKERFILE already exists" >&2
        exit 1
    fi
    cat > "$DOCKERFILE" <<'DOCKERFILE'
# Dockerfile.codebox — project dependencies for codebox-web
# =========================================================
# Your coding agent (OpenCode) can edit or recreate this file to
# pre-install system packages, language runtimes, and project deps.
#
# No FROM line needed — the script auto-injects the correct base image
# (codebox-opencode).
#
# Container context:
#   HOME = /home/sandbox
#   USER = your host uid:gid (e.g. 1000:1000)
#   Working directory = your project directory (mounted read-write)
#   Credentials ~/.config/opencode = mounted from host
#   Git config = mounted from host (~/.gitconfig, read-only)
#   Tailscale socket = shared with sidecar for 'tailscale serve'
#
# The base image is Debian trixie-slim with curl, git, ca-certificates
# and xdg-utils pre-installed. You have full apt access for additional
# packages.

# Install system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    # add packages here (one per line) \
    && rm -rf /var/lib/apt/lists/*

# Install language runtimes (examples):
# RUN curl -fsSL https://astral.sh/uv/install.sh | sh
# RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && apt-get install -y nodejs

# Install project dependencies (examples):
# RUN uv sync
# RUN npm install

# Build step (example):
# RUN make build
DOCKERFILE
    echo "Wrote $DOCKERFILE" >&2
    ;;

up)
    ensure_compose_plugin
    ensure_base_image

    # Check for a project-specific Dockerfile (opt-out via --no-dockerfile)
    PROJECT_DOCKERFILE="$TARGET_DIR/Dockerfile.codebox"
    if ! $NO_DOCKERFILE && [[ -f "$PROJECT_DOCKERFILE" ]]; then
        DIR_HASH="$(echo "$TARGET_DIR" | sha256sum | cut -c1-12)"
        PROJECT_IMAGE="codebox-opencode--${DIR_HASH}"
        DOCKERFILE_SHA="$(sha256sum "$PROJECT_DOCKERFILE" | cut -d' ' -f1)"

        TRUST_STORE="${XDG_CONFIG_HOME:-$HOME/.config}/codebox/trusted"
        TRUST_KEY="${DOCKERFILE_SHA}  ${TARGET_DIR}"
        if ! $TRUST && { [[ ! -f "$TRUST_STORE" ]] || ! grep -qxF "$TRUST_KEY" "$TRUST_STORE"; }; then
            echo "warning: $TARGET_DIR contains a Dockerfile.codebox." >&2
            echo "  It will be built and run on your machine; it can execute arbitrary" >&2
            echo "  code and read mounted credentials. Only trust directories you control." >&2
            if [[ ! -t 0 ]]; then
                echo "error: refusing to build untrusted Dockerfile.codebox without a tty." >&2
                echo "       Re-run with --trust if you trust this directory." >&2
                exit 1
            fi
            read -r -p "Build and run it? [y/N] " ans
            if [[ "$ans" != [yY] && "$ans" != [yY][eE][sS] ]]; then
                echo "Aborted." >&2
                exit 1
            fi
        fi
        mkdir -p "$(dirname "$TRUST_STORE")"
        grep -qxF "$TRUST_KEY" "$TRUST_STORE" 2>/dev/null || echo "$TRUST_KEY" >> "$TRUST_STORE"

        EXISTING_SHA="$(docker image inspect "$PROJECT_IMAGE" \
            --format '{{index .Config.Labels "claude-sandbox.dockerfile.sha256"}}' 2>/dev/null || true)"
        if $REBUILD || [[ "$EXISTING_SHA" != "$DOCKERFILE_SHA" ]]; then
            echo "Building project image for $TARGET_DIR..." >&2
            # Auto-inject FROM codebox-opencode. Strip any existing FROM from
            # the user's Dockerfile.codebox.
            {
                echo "FROM codebox-opencode"
                if head -1 "$PROJECT_DOCKERFILE" | grep -qi '^FROM '; then
                    tail -n +2 "$PROJECT_DOCKERFILE"
                else
                    cat "$PROJECT_DOCKERFILE"
                fi
            } | docker build \
                "${CACHE_ARG[@]}" \
                --network=host \
                --label "claude-sandbox.dockerfile.sha256=${DOCKERFILE_SHA}" \
                -t "$PROJECT_IMAGE" \
                -f - \
                "$TARGET_DIR"
        fi
        RUN_IMAGE="$PROJECT_IMAGE"
    fi

    generate_compose

    cd "$COMPOSE_DIR"
    if $DETACH; then
        docker compose -p "$PROJECT" up -d
    else
        docker compose -p "$PROJECT" up
    fi

    # Print access info if running detached
    if $DETACH; then
        echo "Waiting for Tailscale..." >&2
        for i in $(seq 1 15); do
            STATUS=$(docker exec "${PROJECT}-tailscale-1" tailscale status 2>/dev/null || true)
            IP=$(echo "$STATUS" | awk 'NR>1 && /^[0-9]/{print $1; exit}')
            NAME=$(echo "$STATUS" | awk 'NR>1 && /^[0-9]/{print $2; exit}')
            if [[ -n "$IP" ]]; then
                docker exec "${PROJECT}-tailscale-1" tailscale serve --bg --https 443 "http://localhost:${PORT}" 2>/dev/null || true
                echo "OpenCode Web:" >&2
                echo "  IP:  http://${IP}:${PORT}" >&2
                echo "  DNS: https://${NAME}  (Tailscale Serve, no port)" >&2
                break
            fi
            sleep 1
        done
        if [[ -z "${IP:-}" ]]; then
            echo "Tailscale may need authentication." >&2
            echo "Check 'codebox-web --logs' for the auth URL." >&2
            echo "Or set TS_AUTH_KEY=tskey-... and restart." >&2
        fi
    fi
    ;;

stop)
    ensure_compose_plugin
    if [[ -f "$COMPOSE_DIR/docker-compose.yml" ]]; then
        cd "$COMPOSE_DIR" && docker compose -p "$PROJECT" down
    else
        echo "Nothing running for $TARGET_DIR" >&2
    fi
    ;;

logs)
    ensure_compose_plugin
    cd "$COMPOSE_DIR" && docker compose -p "$PROJECT" logs -f
    ;;

status)
    ensure_compose_plugin
    cd "$COMPOSE_DIR" 2>/dev/null || true
    echo "Project: $PROJECT" >&2
    docker compose -p "$PROJECT" ps 2>/dev/null || echo "Not running" >&2

    IP=$(docker exec "${PROJECT}-tailscale-1" tailscale ip -4 2>/dev/null || true)
    NAME=$(docker exec "${PROJECT}-tailscale-1" tailscale status 2>/dev/null | awk 'NR>1 && /^[0-9]/{print $2; exit}' || true)
    if [[ -n "$IP" ]]; then
        docker exec "${PROJECT}-tailscale-1" tailscale serve --bg --https 443 "http://localhost:${PORT}" 2>/dev/null || true
        echo "Tailscale IP: $IP" >&2
        echo "URLs:" >&2
        echo "  IP:  http://${IP}:${PORT}" >&2
        echo "  DNS: https://${NAME}  (Tailscale Serve, no port)" >&2
    fi
    ;;
esac
